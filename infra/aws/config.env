# AWS testbed settings (SoT §10). Batches A-D ran in ap-south-2 (Hyderabad) on another account;
# the revision batches (E onwards) run in ap-southeast-2 (Sydney), the only region this account allows.
PROFILE=pdw                  # AWS CLI profile (empty = default credentials)
REGION=ap-southeast-2
AZ=ap-southeast-2a
CLIENT_TYPE=c7i.4xlarge      # 16 vCPU, 32 GiB: runs the crypto client (the system under test).
                             # ARM batch: c7g.4xlarge (Graviton3), same server
SERVER_TYPE=i4i.4xlarge      # 16 vCPU, 128 GiB, 3.75 TB local NVMe: MinIO only (pilot: 8 vCPU + gp3 caps were the bottleneck)
DATA_GB=0                    # 0 = MinIO on the instance-store NVMe (blank after each stop); >0 = extra gp3 volume
DATA_IOPS=6000
DATA_MBPS=500
PLACEMENT=cluster            # same rack for a fast, stable network; set to "none" on capacity errors
KEY_NAME=pqc-bench
PROJECT_TAG=pqc-bench
HOURLY_USD=2.58              # Sydney on-demand: c7i.4xlarge $0.9324 + i4i.4xlarge $1.646 (c7g.4xlarge: $0.7549)
DISK_USD_MONTH=8             # approximate, 90 GB of gp3 root volumes
