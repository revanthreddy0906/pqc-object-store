# AWS testbed settings (SoT §10). Hyderabad: the account's 32-vCPU quota is approved there.
REGION=ap-south-2
AZ=ap-south-2a
CLIENT_TYPE=c7i.4xlarge      # 16 vCPU, 32 GiB: runs the crypto client (the system under test)
SERVER_TYPE=c7i.2xlarge      # 8 vCPU, 16 GiB: MinIO only
DATA_GB=200                  # MinIO data disk (gp3)
DATA_IOPS=6000
DATA_MBPS=500
PLACEMENT=cluster            # same rack for a fast, stable network; set to "none" on capacity errors
KEY_NAME=pqc-bench
PROJECT_TAG=pqc-bench
HOURLY_USD=1.1               # approximate, both VMs running; check the AWS pricing page
DISK_USD_MONTH=30            # approximate, 290 GB gp3 incl. extra IOPS/throughput
