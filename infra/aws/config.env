# AWS testbed settings (SoT §10). Hyderabad: the account's 32-vCPU quota is approved there.
REGION=ap-south-2
AZ=ap-south-2a
CLIENT_TYPE=c7i.4xlarge      # 16 vCPU, 32 GiB: runs the crypto client (the system under test)
SERVER_TYPE=i4i.4xlarge      # 16 vCPU, 128 GiB, 3.75 TB local NVMe: MinIO only (pilot: 8 vCPU + gp3 caps were the bottleneck)
DATA_GB=0                    # 0 = MinIO on the instance-store NVMe (blank after each stop); >0 = extra gp3 volume
DATA_IOPS=6000
DATA_MBPS=500
PLACEMENT=cluster            # same rack for a fast, stable network; set to "none" on capacity errors
KEY_NAME=pqc-bench
PROJECT_TAG=pqc-bench
HOURLY_USD=2.3               # approximate, both VMs running (c7i.4xlarge + i4i.4xlarge)
DISK_USD_MONTH=8             # approximate, 90 GB of gp3 root volumes
