# Environments and local builds
.venv/
.local/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Secrets: credentials and private keys never enter Git (SoT §7.1)
.env
keys/
*.key
*.pem

# Generated data
fixtures/*.bin
recovered.bin
experiments/*/
!experiments/.gitkeep
results/raw/

.DS_Store

# LaTeX intermediates (tectonic keeps none by default)
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
